.DS_Store

# Benchmark run workspaces and local agent state.
agent-benchmark/6-runs/1-baseline/
agent-benchmark/6-runs/2-candidate/

# Generated benchmark result snapshots.
agent-benchmark/7-reports/score-ledger.jsonl
agent-benchmark/7-reports/latest-comparison.md
agent-benchmark/7-reports/1-comparisons/best-candidates.md
agent-benchmark/7-reports/0-baselines/*/*/*.md
agent-benchmark/7-reports/1-comparisons/*/*.md

# Generated prompt-optimization outputs.
agent-benchmark/5-prompts/0-agents/patches/best-candidates.md
agent-benchmark/5-prompts/0-agents/patches/vibe/*.md
agent-benchmark/5-prompts/0-agents/patches/claude-code/*.md
!agent-benchmark/5-prompts/0-agents/patches/*/.gitkeep

# Evaluator-instantiated experiment manifests are run-specific by default.
agent-benchmark/6-runs/0-experiments/*.env
!agent-benchmark/6-runs/0-experiments/README.md

# git
.gitkeep
